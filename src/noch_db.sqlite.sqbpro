INSERT OR IGNORE INTO reviews
(review_id,product_id,user_id,customer_name,rating,comment,helpful,unhelpful,flagged,editable_until,created_at)
VALUES
('demo-r1','1','demo-u1','Sarah M',5,'Absolutely love this bottle. Keeps my drinks cold all day and looks great on my desk.',14,1,0,NULL,'2025-11-10 09:15:00'),
('demo-r2','1','demo-u2','James T',4,'Really solid quality. Only gripe is the lid can be a bit stiff at first but loosens up.',8,0,0,NULL,'2025-11-18 14:22:00'),
('demo-r3','1','demo-u3','Priya K',5,'Perfect minimalist design. No logos, no fuss. Exactly what I wanted.',19,2,0,NULL,'2025-12-01 11:05:00'),
('demo-r4','2','demo-u1','Sarah M',5,'Best tote I have ever owned. Fits my laptop, gym kit and lunch with room to spare.',22,0,0,NULL,'2025-10-05 08:30:00'),
('demo-r5','2','demo-u4','Oliver R',3,'Good bag but the strap is a little short for me. Great quality canvas though.',5,1,0,NULL,'2025-10-20 16:45:00'),
('demo-r6','3','demo-u2','James T',5,'This notebook is perfect. Lay-flat binding is a game changer for journaling.',15,0,0,NULL,'2025-09-12 10:00:00'),
('demo-r7','3','demo-u5','Emma L',4,'Love the clean design and quality paper. Would like a dotted grid option.',9,1,0,NULL,'2025-09-28 13:30:00'),
('demo-r8','4','demo-u3','Priya K',4,'Smooth and consistent ink. Great value for three pens. Very pleased.',6,0,0,NULL,'2025-08-15 09:00:00'),
('demo-r9','5','demo-u4','Oliver R',5,'Thinnest wallet I have used and it holds all my cards perfectly.',20,0,0,NULL,'2025-07-22 17:15:00'),
('demo-r10','5','demo-u5','Emma L',5,'Beautifully made. Slim profile and genuine leather. Worth every penny.',17,1,0,NULL,'2025-08-03 12:00:00'),
('demo-r11','6','demo-u1','Sarah M',4,'Simple and strong. Does exactly what a keyring should do.',4,0,0,NULL,'2025-06-30 10:30:00'),
('demo-r12','6','demo-u2','James T',5,'Quality is impressive for the price. Very happy with this purchase.',7,0,0,NULL,'2025-07-10 15:00:00');
